{
    "name": "alfa-agent-mcp",
    "version": "1.0.0",
    "description": "Local advanced MCP server for coding agents, project tools, memory, safe file access, and controlled terminal actions.",
    "type": "module",
    "private": true,
    "bin": {
        "alfa-agent-mcp": "dist/cli.js"
    },
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint src test --ext .ts",
        "typecheck": "tsc --noEmit",
        "test": "node scripts/run-tests.mjs",
        "smoke:oauth": "powershell -ExecutionPolicy Bypass -File scripts/smoke-oauth.ps1",
        "env:guard": "node scripts/check-env-reads.mjs",
        "release:check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run env:guard"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.10.0",
        "@srbhptl39/mcp-superassistant-proxy": "^0.1.8",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^22.15.3",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.59.2",
        "@typescript-eslint/parser": "^8.59.2",
        "eslint": "^9.39.4",
        "tsx": "^4.19.4",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=20.19.0 <21",
        "npm": ">=10.8.0 <12"
    },
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli.js"
    },
    "files": [
        "dist",
        "scripts/check-env-reads.mjs",
        "scripts/report-env-debt.mjs",
        "docs/release-readiness.md",
        ".nvmrc"
    ],
    "main": "test-debug.js",
    "directories": {
        "doc": "docs",
        "test": "test"
    },
    "keywords": [],
    "author": "",
    "license": "ISC"
}
